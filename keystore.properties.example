# Copy this file to "keystore.properties" (that name is git-ignored) and point
# it at your own signing key.
#
# Without this file the release build falls back to the Android debug key.
# That is fine for an APK you only install on your own phone, but not for one
# you hand to other people: Android refuses to install a new APK over an old
# one when the two were signed by different keys, so every user would have to
# uninstall the app before they could update it.
#
# Create a key once:
#
#   keytool -genkeypair -v -keystore my-release.jks -alias my-app \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file and these passwords somewhere safe and backed up. If the
# key is lost, every phone that has the app installed has to uninstall it
# before a new version can be installed.

storeFile=/absolute/path/to/my-release.jks
storePassword=your-store-password
keyAlias=my-app
keyPassword=your-key-password
